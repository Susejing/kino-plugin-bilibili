{
  "id": "bilibili",
  "name": "Bilibili",
  "version": "0.3.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Videos de Bilibili. Usa navegador oculto si la API bloquea el stream.",
  "author": "Susejing",
  "homepage": "https://github.com/Susejing/kino-plugin-bilibili",
  "hosts": [
    "api.bilibili.com",
    "www.bilibili.com",
    "*.bilibili.com",
    "*.bilivideo.com",
    "interface.bilibili.com"
  ],
  "streamHosts": "any",
  "browser": true,
  "capabilities": ["search", "home", "resolve"],
  "color": "#FB7299",
  "categories": ["anime", "movies", "series"]
}
